{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build (build/build.sh)",
      "type": "shell",
      "command": "./build.sh",
      "options": {
        "cwd": "${workspaceFolder}/build"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      },
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}
